<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>TotkCave</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Authors>Mind</Authors>
    <Description>C# library for parsing, decompressing, building, and exporting Tears of the Kingdom cave and quad mesh files.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    McSharp decodes the romfs cave pages, and brings the zstd the quad pages use with it. A
    sibling checkout wins (the viewer vendors both side by side); otherwise the package.
  -->
  <PropertyGroup>
    <McSharpProject Condition="'$(McSharpProject)' == ''">$(MSBuildThisFileDirectory)..\McSharp\src\McSharp\McSharp.csproj</McSharpProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(McSharpProject)" Condition="Exists('$(McSharpProject)')" />
    <PackageReference Include="MeshCodecSharp" Version="1.1.1" Condition="!Exists('$(McSharpProject)')" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
